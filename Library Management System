-- =========================================
-- SHOW ALL BOOKS
-- =========================================

SELECT * FROM books;

-- =========================================
-- SHOW ALL STUDENTS
-- =========================================

SELECT * FROM students;

-- =========================================
-- SHOW ISSUED BOOKS
-- =========================================

SELECT
students.first_name,
students.last_name,
books.title,
book_issue.issued_date,
book_issue.return_date

FROM book_issue

JOIN students
ON book_issue.student_id = students.student_id

JOIN books
ON book_issue.book_id = books.book_id;

-- =========================================
-- COUNT TOTAL BOOKS
-- =========================================

SELECT COUNT(*) AS total_books
FROM books;

-- =========================================
-- SHOW BOOKS CATEGORY WISE
-- =========================================

SELECT
book_categories.category,
COUNT(books.book_id) AS total_books

FROM books

JOIN book_categories
ON books.category_id = book_categories.id

GROUP BY book_categories.category;

-- =========================================
-- SHOW STUDENTS FROM BCA
-- =========================================

SELECT
students.first_name,
students.last_name,
branches.branch

FROM students

JOIN branches
ON students.branch = branches.id

WHERE branches.branch = 'BCA';
